# Salin file ini menjadi `.env` dan isi kunci API kamu.
# (Jika menggunakan Streamlit Cloud, kunci juga bisa diisi di Secrets.)

GROQ_API_KEY=

# Google Gemini (dipakai sebagai fallback saat Groq terkena rate limit).
# Cukup isi salah satu: GEMINI_API_KEY atau GOOGLE_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
